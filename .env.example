# Скопируйте в .env и впишите ключ. .env в git не попадает.
# Используется режимом `uv run giga_agent cli` (giga_agent.conf.json).
GIGA_AGENT_GIGACHAT_FROM_ENV=true
# Ключ авторизации (Authorization key) из личного кабинета GigaChat API
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS — физлицо, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлицо
GIGACHAT_SCOPE=GIGACHAT_API_PERS
