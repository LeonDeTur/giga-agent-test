# Личный Authorization key: Base64 от uuid:uuid, без Basic и угловых скобок.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# Учётная запись преподавателя; на новой БД создаётся автоматически.
GIGA_AGENT_ADMIN_EMAIL=admin@example.com
GIGA_AGENT_ADMIN_PASSWORD=giga_agent_admin
# Сгенерируется командой setup; не публикуйте .env.
LITELLM_MASTER_KEY=
# Все пять портов должны быть свободны и различаться.
GIGA_AGENT_PORT=9090
MCP_FILES_PORT=8101
MCP_FETCH_PORT=8102
INFINITY_PORT=8103
LITELLM_PORT=8104

